# debug, info, warn, or error
AQ_LOG_LEVEL=info
AQ_OLLAMA_MODEL=gemma4:e4b
AQ_OLLAMA_HOST=http://127.0.0.1:11434/
AQ_OLLAMA_BEARER_TOKEN=remove-unless-needed
AQ_OLLAMA_CONTEXT_LIMIT=131072
# how long ollama keeps the model loaded; -1 never unloads it, 0 unloads it immediately.
AQ_OLLAMA_KEEP_ALIVE=30m
# owner/name of a huggingface.co repo - tokenizer.json and tokenizer_config.json
# are downloaded once to ~/.agentiq/tokenizers on first run
AQ_HF_TOKENIZER_REPO=google/gemma-4-E4B
# needed only for gated or private repos - falls back to HF_TOKEN
# AQ_HF_TOKEN=hf_...
# Comment out to use platform default
# AQ_SHELL=/bin/bash
AQ_SHELL_TIMEOUT=120000
# how many saved sessions to keep in ~/.agentiq/sessions; older ones are deleted
# at startup. 0 keeps them all
AQ_SESSION_LIMIT=50
# manual, auto, or plan - cycle at runtime with shift+tab
AQ_APPROVAL_MODE=manual
